#include <stdio.h>

int main()
{
    int values[] = {10, 20, 30};
    int *ptr = values;

    printf("Current value: %d\n", *ptr);

    ptr++;
    printf("After increment: %d\n", *ptr);

    ptr++;
    printf("After second increment: %d\n", *ptr);

    ptr--;
    printf("After decrement: %d\n", *ptr);

    return 0;
}
